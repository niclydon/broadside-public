# Broadside public showcase environment example

# Showcase guardrail
BROADSIDE_SHOWCASE_DEMO=true

# App database
DATABASE_URL=postgresql://broadside:CHANGEME@localhost:5432/broadside

# Optional read-only context warehouse
WAREHOUSE_READONLY_DATABASE_URL=postgresql://broadside_reader:CHANGEME@localhost:5432/context_warehouse

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LOCAL_MODEL_GATEWAY_API_KEY=demo-key
LOCAL_MODEL_GATEWAY_BASE_URL=http://localhost:8080/v1

# Optional repo ingestion
GITHUB_TOKEN=github_pat_...
PROJECTS_ROOT=/workspace

# Assets
BROADSIDE_MEDIA_ROOT=/data/broadside/media

# Logging
LOG_LEVEL=normal

# HTTP port
BROADSIDE_PORT=7720
